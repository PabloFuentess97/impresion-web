// ==============================================================
//  ImpresiónWeb — Esquema de base de datos (Prisma + PostgreSQL)
// ==============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados posibles de una incidencia.
enum EstadoIncidencia {
  ABIERTA
  EN_PROCESO
  RESUELTA
}

/// Rol del usuario dentro del sistema.
enum RolUsuario {
  ADMIN
  /// Solo lectura: acceso limitado a ver Proyectos y Salidas.
  LECTOR
}

/// Estado de una recogida registrada por un trabajador (vía QR).
enum EstadoRecogida {
  PENDIENTE
  APROBADA
  DENEGADA
}

/// Usuario administrador. No existe registro público.
model Usuario {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String // Hash bcrypt
  nombre    String
  rol       RolUsuario @default(ADMIN)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("usuarios")
}

/// Proyecto de impresión. Agrupa muchas impresiones y salidas.
model Proyecto {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  /// Ruta de impresión en texto plano (no se sube ningún archivo).
  rutaImpresion String?
  /// Cantidad objetivo a producir (lo que hay que hacer). Opcional.
  cantidadProduccion Int?
  /// Notas del proyecto en HTML enriquecido (editor WYSIWYG). Opcional.
  notas       String?
  /// Si está bloqueado, se resalta en el listado y requiere confirmación
  /// para desbloquearlo.
  bloqueado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  impresiones Impresion[]
  salidas     Salida[]
  recogidas   Recogida[]

  @@index([createdAt])
  @@map("proyectos")
}

/// Impresión concreta perteneciente a un proyecto.
model Impresion {
  id         String   @id @default(cuid())
  nombre     String
  cantidad   Int      @default(1)
  /// Tiempo empleado en MINUTOS.
  tiempo     Int      @default(0)
  /// Solo fecha (sin hora). Se registra automáticamente al crear.
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  ubicaciones UbicacionImpresion[]

  @@index([proyectoId])
  @@index([fecha])
  @@map("impresiones")
}

/// Estancia o plano visual donde se dibujan zonas de almacenaje.
model EstanciaMapa {
  id        String   @id @default(cuid())
  nombre    String
  descripcion String?
  /// Dimensiones lógicas del lienzo visual.
  ancho     Int      @default(1200)
  alto      Int      @default(800)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zonas     ZonaMapa[]

  @@index([orden])
  @@map("estancias_mapa")
}

/// Zona dibujada dentro de una estancia (almacenaje, mesa, estantería, etc.).
model ZonaMapa {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  /// Coordenadas y tamaño en porcentaje (0-100) para ser responsive.
  x           Float
  y           Float
  ancho       Float
  alto        Float
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estanciaId  String
  estancia    EstanciaMapa @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  ubicaciones UbicacionImpresion[]

  @@index([estanciaId])
  @@map("zonas_mapa")
}

/// Asignación opcional de una impresión a una zona del mapa.
model UbicacionImpresion {
  id          String   @id @default(cuid())
  cantidad    Int?
  nota        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  impresionId String
  impresion   Impresion @relation(fields: [impresionId], references: [id], onDelete: Cascade)
  zonaId      String
  zona        ZonaMapa  @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@index([impresionId])
  @@index([zonaId])
  @@unique([impresionId, zonaId])
  @@map("ubicaciones_impresion")
}

/// Salida de material: unidades/etiquetas de un proyecto enviadas a un destino.
model Salida {
  id         String   @id @default(cuid())
  /// Cantidad de unidades / etiquetas que salen.
  cantidad   Int      @default(1)
  /// Destino al que se envían (texto libre, sin clientes).
  destino    String
  /// Nota opcional.
  nota       String?
  /// Solo fecha (sin hora). Se registra automáticamente al crear.
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@index([fecha])
  @@map("salidas")
}

/// Incidencia independiente con descripción enriquecida (HTML de Tiptap).
model Incidencia {
  id          String           @id @default(cuid())
  titulo      String
  /// HTML enriquecido generado por el editor WYSIWYG.
  descripcion String
  estado      EstadoIncidencia @default(ABIERTA)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([estado])
  @@index([createdAt])
  @@map("incidencias")
}

/// Tinta configurada en el sistema (p. ej. Cian, Magenta...).
/// El número de tintas activas (4, 6 o 9) equivale al número de registros.
model Tinta {
  id         String   @id @default(cuid())
  nombre     String
  /// Color hexadecimal para mostrar la muestra visual.
  color      String   @default("#6366F1")
  /// Orden de visualización.
  orden      Int      @default(0)
  /// Porcentaje actual de tinta (0-100).
  porcentaje Float    @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lecturas   LecturaTinta[]

  @@index([orden])
  @@map("tintas")
}

/// Lectura histórica del porcentaje de una tinta en una fecha concreta.
/// Permite comparar el nivel anterior con el actual en los reportes.
model LecturaTinta {
  id         String   @id @default(cuid())
  porcentaje Float
  /// Solo fecha (sin hora).
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())

  tintaId    String
  tinta      Tinta    @relation(fields: [tintaId], references: [id], onDelete: Cascade)

  @@index([tintaId])
  @@index([fecha])
  @@map("lecturas_tinta")
}

/// Papel: registro del número de rollos disponibles.
model Papel {
  id        String   @id @default(cuid())
  nombre    String   @default("Papel")
  /// Número de rollos actuales.
  rollos    Int      @default(0)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecturas  LecturaPapel[]

  @@index([orden])
  @@map("papel")
}

/// Lectura histórica del número de rollos de papel en una fecha concreta.
model LecturaPapel {
  id        String   @id @default(cuid())
  rollos    Int
  /// Solo fecha (sin hora).
  fecha     DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())

  papelId   String
  papel     Papel    @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@index([papelId])
  @@index([fecha])
  @@map("lecturas_papel")
}

/// Artículo de inventario: nombre y cantidad disponible.
model Inventario {
  id        String   @id @default(cuid())
  nombre    String
  cantidad  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("inventario")
}

/// Recogida de unidades registrada por un trabajador desde el formulario QR.
/// Queda PENDIENTE hasta que el administrador la aprueba o deniega.
/// Al aprobar se genera una Salida (se descuenta del proyecto).
model Recogida {
  id         String         @id @default(cuid())
  /// Identificador del trabajador (texto libre, sin cuenta).
  nbi        String
  nombre     String
  unidades   Int
  estado     EstadoRecogida @default(PENDIENTE)
  /// Solo fecha (sin hora) de la solicitud.
  fecha      DateTime       @default(now()) @db.Date
  createdAt  DateTime       @default(now())
  /// Momento en que se aprobó o denegó.
  resueltoEn DateTime?
  /// Salida generada al aprobar (referencia suelta, sin relación formal).
  salidaId   String?

  proyectoId String
  proyecto   Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@index([proyectoId])
  @@index([createdAt])
  @@map("recogidas")
}

/// Configuración global de la aplicación (registro único).
model Configuracion {
  id            String   @id @default(cuid())
  nombreEmpresa String   @default("ImpresiónWeb")
  logoUrl       String?
  tema          String   @default("system") // "light" | "dark" | "system"
  /// Token secreto del enlace del QR de recogidas (regenerable).
  recogidaToken String?
  updatedAt     DateTime @updatedAt

  @@map("configuracion")
}
