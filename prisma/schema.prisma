// ==============================================================
//  ImpresiónWeb — Esquema de base de datos (Prisma + PostgreSQL)
// ==============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados posibles de una incidencia.
enum EstadoIncidencia {
  ABIERTA
  EN_PROCESO
  RESUELTA
}

/// Rol del usuario dentro del sistema.
enum RolUsuario {
  ADMIN
}

/// Usuario administrador. No existe registro público.
model Usuario {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String // Hash bcrypt
  nombre    String
  rol       RolUsuario @default(ADMIN)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("usuarios")
}

/// Proyecto de impresión. Agrupa muchas impresiones y salidas.
model Proyecto {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  /// Ruta de impresión en texto plano (no se sube ningún archivo).
  rutaImpresion String?
  /// Si está bloqueado, se resalta en el listado y requiere confirmación
  /// para desbloquearlo.
  bloqueado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  impresiones Impresion[]
  salidas     Salida[]

  @@index([createdAt])
  @@map("proyectos")
}

/// Impresión concreta perteneciente a un proyecto.
model Impresion {
  id         String   @id @default(cuid())
  nombre     String
  cantidad   Int      @default(1)
  /// Tiempo empleado en MINUTOS.
  tiempo     Int      @default(0)
  /// Solo fecha (sin hora). Se registra automáticamente al crear.
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@index([fecha])
  @@map("impresiones")
}

/// Salida de material: unidades/etiquetas de un proyecto enviadas a un destino.
model Salida {
  id         String   @id @default(cuid())
  /// Cantidad de unidades / etiquetas que salen.
  cantidad   Int      @default(1)
  /// Destino al que se envían (texto libre, sin clientes).
  destino    String
  /// Nota opcional.
  nota       String?
  /// Solo fecha (sin hora). Se registra automáticamente al crear.
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@index([fecha])
  @@map("salidas")
}

/// Incidencia independiente con descripción enriquecida (HTML de Tiptap).
model Incidencia {
  id          String           @id @default(cuid())
  titulo      String
  /// HTML enriquecido generado por el editor WYSIWYG.
  descripcion String
  estado      EstadoIncidencia @default(ABIERTA)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([estado])
  @@index([createdAt])
  @@map("incidencias")
}

/// Tinta configurada en el sistema (p. ej. Cian, Magenta...).
/// El número de tintas activas (4, 6 o 9) equivale al número de registros.
model Tinta {
  id         String   @id @default(cuid())
  nombre     String
  /// Color hexadecimal para mostrar la muestra visual.
  color      String   @default("#6366F1")
  /// Orden de visualización.
  orden      Int      @default(0)
  /// Porcentaje actual de tinta (0-100).
  porcentaje Float    @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lecturas   LecturaTinta[]

  @@index([orden])
  @@map("tintas")
}

/// Lectura histórica del porcentaje de una tinta en una fecha concreta.
/// Permite comparar el nivel anterior con el actual en los reportes.
model LecturaTinta {
  id         String   @id @default(cuid())
  porcentaje Float
  /// Solo fecha (sin hora).
  fecha      DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())

  tintaId    String
  tinta      Tinta    @relation(fields: [tintaId], references: [id], onDelete: Cascade)

  @@index([tintaId])
  @@index([fecha])
  @@map("lecturas_tinta")
}

/// Papel: registro del número de rollos disponibles.
model Papel {
  id        String   @id @default(cuid())
  nombre    String   @default("Papel")
  /// Número de rollos actuales.
  rollos    Int      @default(0)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecturas  LecturaPapel[]

  @@index([orden])
  @@map("papel")
}

/// Lectura histórica del número de rollos de papel en una fecha concreta.
model LecturaPapel {
  id        String   @id @default(cuid())
  rollos    Int
  /// Solo fecha (sin hora).
  fecha     DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())

  papelId   String
  papel     Papel    @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@index([papelId])
  @@index([fecha])
  @@map("lecturas_papel")
}

/// Artículo de inventario: nombre y cantidad disponible.
model Inventario {
  id        String   @id @default(cuid())
  nombre    String
  cantidad  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("inventario")
}

/// Configuración global de la aplicación (registro único).
model Configuracion {
  id            String   @id @default(cuid())
  nombreEmpresa String   @default("ImpresiónWeb")
  logoUrl       String?
  tema          String   @default("system") // "light" | "dark" | "system"
  updatedAt     DateTime @updatedAt

  @@map("configuracion")
}
