# ==============================================================
#  ImpresiónWeb — Variables de entorno
#  Copia este archivo como .env y completa los valores.
# ==============================================================

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/impresionweb?schema=public"

# --- Autenticación (Auth.js / NextAuth v5) ---
# Genera un secreto seguro con:  npx auth secret   (o)   openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la aplicación (en SeeNode usa la URL del despliegue).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Confía en el host en despliegues detrás de proxy (SeeNode).
AUTH_TRUST_HOST="true"

# --- Credenciales del administrador inicial (usadas por el seed) ---
ADMIN_EMAIL="admin@impresionweb.com"
ADMIN_PASSWORD="Admin1234!"
ADMIN_NOMBRE="Administrador"
